{
"name": "vite-et-gourmand-api",
  "version": "1.0.0",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "copy:front": "ncp vite-et-gourmand-front public",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/style.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/style.css --watch"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.13.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "ncp": "^2.0.0",
    "tailwindcss": "^3.4.17"
  }
}
